    <link rel="stylesheet" href="css/style.css">

    <style>
        /* ========================================
           COURSE DETAIL PAGE
        ======================================== */

        .course-hero {
            padding: 75px 0;
            background:
                radial-gradient(
                    circle at 10% 20%,
                    rgba(37, 99, 235, 0.13),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #f8fafc,
                    #eff6ff
                );
        }

        .course-hero-content {
            display: grid;
            grid-template-columns: 1.3fr 0.7fr;
            gap: 60px;
            align-items: center;
        }

        .course-breadcrumb {
            margin-bottom: 20px;
            color: var(--muted);
            font-size: 14px;
        }

        .course-breadcrumb a {
            color: var(--primary);
            font-weight: 700;
        }

        .course-hero h1 {
            max-width: 700px;
            font-size: clamp(38px, 5vw, 58px);
            line-height: 1.08;
            letter-spacing: -1.5px;
            margin-bottom: 20px;
        }

        .course-hero-description {
            max-width: 650px;
            color: var(--text);
            font-size: 17px;
            margin-bottom: 25px;
        }

        .course-info-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            color: var(--muted);
            font-size: 14px;
        }

        .course-info-row span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .course-info-row .rating {
            color: #f59e0b;
            font-weight: 700;
        }

        /* PURCHASE CARD */

        .purchase-card {
            background: white;
            padding: 25px;
            border-radius: 22px;
            border: 1px solid var(--border);
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12);
        }

        .course-preview {
            height: 190px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 22px;

            border-radius: 15px;

            background:
                linear-gradient(
                    135deg,
                    #dbeafe,
                    #bfdbfe
                );

            font-size: 70px;
        }

        .price {
            font-size: 28px;
            font-weight: 800;
            color: var(--dark);
        }

        .old-price {
            margin-left: 8px;
            color: #94a3b8;
            text-decoration: line-through;
            font-size: 15px;
        }

        .buy-btn {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;

            margin-top: 20px;
            padding: 15px;

            background: var(--primary);
            color: white;

            border: none;
            border-radius: 10px;

            cursor: pointer;

            font-size: 16px;
            font-weight: 700;

            transition: 0.3s;
        }

        .buy-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .purchase-note {
            margin-top: 15px;
            text-align: center;
            color: var(--muted);
            font-size: 12px;
        }

        /* COURSE CONTENT */

        .course-content-section {
            background: white;
        }

        .course-layout {
            display: grid;
            grid-template-columns: 1.5fr 0.5fr;
            gap: 60px;
        }

        .content-title {
            margin-bottom: 25px;
            font-size: 30px;
        }

        .course-description {
            color: var(--text);
            font-size: 16px;
            margin-bottom: 35px;
        }

        /* WHAT YOU LEARN */

        .learn-box {
            padding: 30px;
            margin-bottom: 45px;

            background: #f8fafc;

            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        .learn-box h2 {
            margin-bottom: 22px;
            font-size: 25px;
        }

        .learn-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .learn-list div {
            display: flex;
            gap: 10px;
            color: var(--text);
            font-size: 14px;
        }

        .learn-list span {
            color: #16a34a;
            font-weight: 800;
        }

        /* LESSONS */

        .lessons {
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }

        .lessons-header {
            padding: 22px 25px;
            background: #f8fafc;
            border-bottom: 1px solid var(--border);
        }

        .lessons-header h2 {
            font-size: 23px;
        }

        .lessons-header p {
            color: var(--muted);
            font-size: 14px;
            margin-top: 4px;
        }

        .lesson-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;

            padding: 19px 25px;

            border-bottom: 1px solid var(--border);

            transition: 0.3s;
        }

        .lesson-item:last-child {
            border-bottom: none;
        }

        .lesson-item:hover {
            background: #f8fafc;
        }

        .lesson-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .lesson-number {
            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 9px;

            background: #eff6ff;
            color: var(--primary);

            font-size: 13px;
            font-weight: 800;
        }

        .lesson-name {
            font-weight: 700;
            font-size: 14px;
        }

        .lesson-time {
            color: var(--muted);
            font-size: 12px;
        }

        /* SIDEBAR */

        .course-sidebar {
            position: sticky;
            top: 100px;
            height: fit-content;
        }

        .sidebar-card {
            padding: 25px;

            background: #f8fafc;

            border: 1px solid var(--border);
            border-radius: var(--radius);

            margin-bottom: 20px;
        }

        .sidebar-card h3 {
            margin-bottom: 18px;
            font-size: 20px;
        }

        .course-feature {
            display: flex;
            gap: 12px;
            align-items: center;

            margin-bottom: 16px;

            color: var(--text);
            font-size: 14px;
        }

        .course-feature:last-child {
            margin-bottom: 0;
        }

        .course-feature-icon {
            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: white;

            border-radius: 9px;
        }

        /* INSTRUCTOR */

        .instructor {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .instructor-avatar {
            width: 55px;
            height: 55px;

            display: flex;
            align-items: center;
            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #7c3aed
                );

            border-radius: 50%;

            color: white;
            font-size: 23px;
        }

        .instructor strong {
            display: block;
        }

        .instructor span {
            color: var(--muted);
            font-size: 12px;
        }

        /* RESPONSIVE */

        @media (max-width: 900px) {

            .course-hero-content,
            .course-layout {
                grid-template-columns: 1fr;
            }

            .purchase-card {
                max-width: 600px;
            }

            .course-sidebar {
                position: static;
            }
        }

        @media (max-width: 600px) {

            .course-hero {
                padding: 55px 0;
            }

            .course-hero h1 {
                font-size: 38px;
            }

            .learn-list {
                grid-template-columns: 1fr;
            }

            .lesson-item {
                padding: 16px;
            }

            .lesson-time {
                display: none;
            }
        }
    </style>
</head>

